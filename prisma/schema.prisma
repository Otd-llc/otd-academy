// Connection URLs are configured in `prisma.config.ts` (Prisma 7).
// See: https://pris.ly/d/config-datasource

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ─── Auth.js v5 adapter models ─────────────────────────
enum UserRole {
  ADMIN
  LEARNER
}

enum XpSource {
  QUIZ_CORRECT
  LESSON_COMPLETE
  CLUSTER_COMPLETE
  LIBRARY_COMPLETE
  FEEDBACK_SUBMIT
  FEEDBACK_USEFUL
  // Course (build-guide) XP — Phase 2 (design 2026-07-11)
  STAGE_QUIZ_CORRECT
  STAGE_CLEAR
  COURSE_EXAM_PASS
  COURSE_COMPLETE
  // Admin manual XP adjustment (2026-07-13) — a signed correction/comp from the
  // per-learner admin tooling. Distinct source so instrumentation can exclude it.
  MANUAL_ADJUST
  // Cross-session review deck correct answer (step 4, 2026-07-21). Once per due
  // cycle (dedupe key embeds the cycle's dueOn), small amount.
  REVIEW_CORRECT
}

enum FeedbackStatus {
  NEW
  USEFUL
  DISMISSED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          UserRole  @default(LEARNER)
  createdAt     DateTime  @default(now())
  stripeCustomerId String? @unique
  // Lifecycle-email consent (GDPR opt-in). Default FALSE: no marketing/lifecycle
  // mail until the user affirmatively opts in (the account "Email" toggle stamps
  // emailConsentUpdatedAt at that moment). Every lifecycle send is guarded by
  // `emailConsent === true`; the unsubscribe route flips it back to false. A null
  // emailConsentUpdatedAt means the user has never made a choice. Transactional mail
  // (magic-link sign-in) is NOT gated by this.
  emailConsent          Boolean   @default(false)
  emailConsentUpdatedAt DateTime?

  // UI theme preference for a signed-in user ("light" | "dark"). Null = no stored
  // choice: the device decides (theme cookie / prefers-color-scheme). Persisted on
  // toggle so the choice follows the account to a new device / after a cookie reset.
  theme                 String?

  // Custom uploaded avatar marker. Presence = the user set their own avatar (stored
  // at the deterministic R2 key avatars/{id}.webp, served via /api/avatar/{id}); the
  // timestamp doubles as a cache-bust version. Null = fall back to the sign-in
  // provider image, else the initial. Additive, nullable.
  avatarUpdatedAt       DateTime?

  // First-run onboarding goal (the motivation picked on the /start survey, or the
  // skip sentinel) + when it was answered. Both null = never answered. Feeds
  // personalization + lifecycle email segmentation. Stored as a string (not an
  // enum) to avoid enum-mirror maintenance for a soft survey value.
  onboardingGoal        String?
  onboardingGoalAt      DateTime?

  // Logbook (XP progression) cached mirrors — recomputable from the XpEvent
  // ledger; updated transactionally with each award. currentThrough = the
  // stay-current window end (status only, design §6). logbookIntroSeenAt = the
  // one-time /library intro panel flag.
  xpTotal            Int       @default(0)
  level              Int       @default(1)
  currentThrough     DateTime? @db.Date
  logbookIntroSeenAt DateTime?

  accounts Account[]
  sessions Session[]

  transitions             StageTransition[]
  artifacts               Artifact[]
  partsCreated            Part[]
  partFacts               PartFact[]
  partDatasheets          PartDatasheet[]
  partAssets              PartAsset[]
  bomLinesCreated         BomLine[]
  projectsCreated         Project[]
  errataCreated           Erratum[]
  revisionsFrozen         Revision[]        @relation("FrozenBy")
  buildsCreated           Build[]
  checklistsCreated       Checklist[]
  guidesCreated           Guide[]
  checklistItemsCompleted ChecklistItem[]   @relation("CompletedBy")
  measurementsTaken       Measurement[]
  projectDependenciesCreated ProjectDependency[]
  enrollments             Enrollment[]
  entitlements            Entitlement[]
  tips                    Tip[]
  purchases               Purchase[]
  subscriptions           Subscription[]
  invoices                Invoice[]
  certificates            Certificate[]
  miniLessons             MiniLesson[]
  lifecycleSends          LifecycleSend[]

  xpEvents          XpEvent[]
  lessonCompletions LessonCompletion[]
  quizLocks         QuizLock[]
  badges            BadgeEarned[]
  lessonFeedback    LessonFeedback[]
  reviewSchedules   ReviewSchedule[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Project + Revision ────────────────────────────────
model Project {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  publicTitle String?  // keyword-rich public title; render publicTitle ?? name
  tagline     String?  // one-line benefit line shown on the skill-tree node card
  targetCost  Decimal?  @db.Decimal(10, 2)
  repoUrl     String?
  track              CurriculumTrack?
  level              CurriculumLevel?
  accessTier         AccessTier           @default(FREE)
  stripePriceId      String?
  priceCents         Int?
  criticalPath       Boolean              @default(true)
  disciplineTaught   String?
  requiresStripboard Boolean              @default(false)
  hasMainsNet        Boolean              @default(false)
  hasLiIon           Boolean              @default(false) // WS2: triggers DESIGN_VALIDATION Li-ion safety conditional
  hasThermalConcern  Boolean              @default(false) // WS2: triggers DESIGN_VALIDATION thermal conditional
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  // The revision whose Guide learners follow (typically a frozen reference).
  // Until an admin sets it, the project is not enrollable.
  publishedRevisionId String?   @unique
  publishedRevision   Revision? @relation("PublishedRevision", fields: [publishedRevisionId], references: [id], onDelete: SetNull)

  revisions Revision[]
  enrollments      Enrollment[]
  exam             Exam?
  dependentEdges   ProjectDependency[] @relation("DependentProject")
  dependsOnEdges   ProjectDependency[] @relation("DependsOnProject")
  entitlements     Entitlement[]
  waitlist         WaitlistSignup[]
  miniLessons      ProjectMiniLesson[]

  @@index([archivedAt])
}

// Per-project access entitlement (GTM Phase 2). owner-XOR (enforced by a CHECK in
// the migration): projectId now; bundleId reserved for Phase 4. source stays
// GRANT until Stripe (Phase 3) adds the PURCHASE path.
model Entitlement {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bundleId  String?
  source    EntitlementSource @default(GRANT)
  createdAt DateTime          @default(now())

  @@unique([userId, projectId])
  // Bundle idempotency: one bundle Entitlement per (user, bundle). A FULL unique
  // index — bundleId is null for project entitlements, and Postgres treats NULLs
  // as distinct, so it does NOT constrain per-project rows (it only bites when
  // bundleId is non-null). This closes the pre-existing hole where two concurrent
  // bundle grants could double-grant, and lets the webhook / pass.ts $0-grant use
  // an idempotent `upsert` on `userId_bundleId` instead of findFirst-then-create.
  @@unique([userId, bundleId])
  @@index([userId])
}

// All-Access Pass / bundle (GTM monetization). A bundle is a single Stripe
// Product whose purchase grants an Entitlement carrying a non-null `bundleId`
// (the owner-XOR alternative to projectId) — which `hasProjectEntitlement` reads
// as access to EVERY project. `key` is the stable lookup ("all-access"); the
// Stripe product carries up to two prices (standard + a time-boxed launch price),
// so we store both cents amounts plus the active Stripe price id. The launch
// window closes at `launchEndsAt`; after it, `currentPassPriceId` falls back to
// the standard price (see src/lib/actions/pass.ts).
model Bundle {
  id               String    @id @default(cuid())
  key              String    @unique
  name             String
  stripePriceId    String?
  priceCents       Int?
  launchPriceCents Int?
  launchEndsAt     DateTime?
  // Recurring all-access via a SUBSCRIPTION (mode "subscription" checkout). The
  // same bundle grants the same access as the one-time Pass; this just holds the
  // recurring Stripe price + its cents. Null until set-subscription-price.ts runs.
  subscriptionPriceId    String?
  subscriptionPriceCents Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// Anonymous email capture for a PREMIUM project's waitlist (pre-Stripe lead-gen).
model WaitlistSignup {
  id        String   @id @default(cuid())
  email     String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([email, projectId])
}

// Anonymous email capture for the All-Access Pass (it isn't on sale yet, so a
// waitlist is the only action). Keyed by email; userId is stamped when a
// signed-in learner joins. Idempotent on the unique email.
model PassWaitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  userId    String?
  createdAt DateTime @default(now())
}

// Stripe webhook idempotency (GTM Phase 3): record each processed event id so a
// redelivered event is a no-op (the create() unique-violation = already handled).
model ProcessedStripeEvent {
  eventId   String   @id
  type      String
  createdAt DateTime @default(now())
}

// A one-time "Support the Academy" tip (GTM — not a course purchase, grants no
// entitlement). Written by the Stripe webhook on a paid checkout.session.completed
// carrying metadata.kind = "tip". The amount comes from Stripe (amount_total),
// never the client. `stripeSessionId` is unique so a webhook redelivery can't
// double-record. `userId` is nullable (guest tips) and SetNull so deleting a user
// keeps the accounting row.
model Tip {
  id              String   @id @default(cuid())
  stripeSessionId String   @unique
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email           String?
  amountCents     Int
  currency        String   @default("usd")
  createdAt       DateTime @default(now())

  @@index([userId])
}

// One row per completed Stripe payment that grants access (course, Pass,
// pay-the-difference upgrade). Written ONLY by the webhook on a paid
// checkout.session.completed (mode "payment"), in the SAME transaction as the
// grant. The audit bridge from Entitlement → Stripe, and the frozen record of
// what was actually paid (grandfathering credit reads amountTotalCents, never the
// current catalog price). The zero-charge "already covered" upgrade grant writes a
// $0 Purchase itself (null stripeSessionId) so every PURCHASE entitlement traces
// to a Purchase row. userId is nullable + SetNull so the audit row survives a hard
// user delete (financial-record retention). Phase-2 columns (refundedCents,
// stripePromotionCodeId, stripeChargeId) exist from day 1 so enabling refunds /
// promo codes is code-only.
model Purchase {
  id                    String   @id @default(cuid())
  userId                String?
  user                  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  projectId             String?  // XOR bundleId (purchase_owner_xor CHECK), like Entitlement
  bundleId              String?
  // Soft reference (indexed, NOT unique, no FK): two completed sessions CAN
  // legitimately point at one entitlement (double-tab checkout = double charge;
  // both payments recorded — the duplicate is refund evidence, not noise). No FK
  // because Entitlement cascades on user delete while Purchase must survive it.
  entitlementId         String?
  // Nullable: the $0 upgrade grant writes a Purchase with NO Stripe session. Its
  // idempotency guard is a findFirst on (entitlementId, stripeSessionId: null)
  // inside the grant transaction; Postgres allows multiple NULLs under a unique,
  // so webhook idempotency on real sessions is unaffected.
  stripeSessionId       String?  @unique
  // PRIMARY refund-correlation key: charge.refunded carries payment_intent, always.
  stripePaymentIntentId String?
  // The Charge id — a DISTINCT Stripe id, completeness-only (not the refund key:
  // it is not on the bare Checkout Session). Filled opportunistically, null-tolerant.
  stripeChargeId        String?
  stripeCustomerId      String?
  stripePriceId         String?  // null for Pass/upgrade (inline price_data, no price id)
  stripeProductId       String?
  amountTotalCents      Int      // session.amount_total — never the client; null-guarded at insert
  amountDiscountCents   Int      @default(0) // session.total_details.amount_discount ?? 0
  stripePromotionCodeId String?  // coupon/promo audit (phase 2)
  refundedCents         Int      @default(0) // SET to charge.amount_refunded (phase 2)
  currency              String   @default("usd")
  metadata              Json?    // session.metadata snapshot — our own ids only, never PII
  createdAt             DateTime @default(now())

  @@index([userId])
  @@index([entitlementId])
}

// Mirror of a Stripe Subscription (recurring all-access / platform access).
// Upserted by customer.subscription.created|updated|deleted. `status` is Stripe's
// status string VERBATIM (no Prisma enum mirror — those drift when Stripe adds
// states). userId nullable + SetNull so the audit row survives a hard user delete.
// An active/trialing subscription mints an all-access bundle Entitlement (source
// SUBSCRIPTION); a non-active status revokes it (see the webhook). Basil+ API note:
// current_period_end lives on subscription.items.data[0], not the Subscription.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String?
  user                 User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  stripeSubscriptionId String    @unique
  stripeCustomerId     String
  stripePriceId        String?
  stripeProductId      String?
  status               String    // active | trialing | past_due | canceled | ...
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  metadata             Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  invoices             Invoice[]

  @@index([userId])
}

// A paid Stripe Invoice (subscription billing). Written ONLY on invoice.paid —
// one-time payments do NOT create invoices (Purchase covers those). Write-once
// (upsert on stripeInvoiceId, update {}). May arrive BEFORE the
// customer.subscription.created upsert, so we always store the raw
// stripeSubscriptionId and resolve the `subscriptionId` FK when the row exists;
// the subscription upsert backfills the FK for any invoice that landed first.
// Basil+ API note: the subscription id lives at
// invoice.parent.subscription_details.subscription, not invoice.subscription.
model Invoice {
  id                   String        @id @default(cuid())
  stripeInvoiceId      String        @unique
  stripeSubscriptionId String?
  subscriptionId       String?
  subscription         Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  userId               String?
  user                 User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  stripeCustomerId     String?
  amountPaidCents      Int
  currency             String        @default("usd")
  periodStart          DateTime?
  periodEnd            DateTime?
  metadata             Json?
  paidAt               DateTime      // from invoice.status_transitions.paid_at
  createdAt            DateTime      @default(now())

  @@index([userId])
  @@index([stripeSubscriptionId])
}

// Refund audit (written on charge.refunded). One row per Stripe Refund object, so
// "which refund reduced this Purchase, when, why" is answerable from our DB.
// Purchase.refundedCents carries the cumulative fast read (SET to
// charge.amount_refunded, never incremented); this is the itemized ledger behind
// it. `purchaseId` is a bare scalar soft-link (no FK): the Purchase is found via
// stripePaymentIntentId, and the audit row must outlive a cascaded/absent Purchase.
model Refund {
  id             String   @id @default(cuid())
  stripeRefundId String   @unique
  stripeChargeId String
  purchaseId     String?
  amountCents    Int
  reason         String?
  status         String   // succeeded | pending | failed | canceled
  createdAt      DateTime @default(now())

  @@index([stripeChargeId])
  @@index([purchaseId])
}

// Chargeback / dispute audit (written on charge.dispute.*). One row per Stripe
// Dispute, tracking its full lifecycle status (needs_response → under_review → won
// / lost). Correlated to the Purchase via the charge's payment_intent. RECORD-ONLY:
// access is NOT auto-revoked on a dispute (an education chargeback is often won, and
// pull-then-restore is worse than an admin decision) — the revoke is a one-line add
// in the webhook if that policy changes.
model Dispute {
  id              String   @id @default(cuid())
  stripeDisputeId String   @unique
  stripeChargeId  String
  purchaseId      String?
  amountCents     Int
  reason          String?
  status          String   // needs_response | under_review | won | lost | ...
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([stripeChargeId])
  @@index([purchaseId])
}

// An ISSUED completion/certificate — the record that makes the printed verify
// code checkable. Written (idempotent on `code`) whenever a learner's share token
// is minted (complete screen / share action). `code` is the human-readable cert
// id printed on the certificate (hash of the signed token); the /verify page looks
// it up. Holds enough to re-render the certificate (the token is re-signed from
// these fields), so no token is stored.
model Certificate {
  id       String   @id @default(cuid())
  code     String   @unique
  slug     String
  name     String
  variant  String // "cert" | "done"
  score    Int?
  total    Int?
  issuedAt DateTime @default(now())
  userId   String?
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([slug])
}

// One row per (user, lifecycle sequence) the cron has sent — the idempotency
// ledger that makes every sequence fire AT MOST ONCE per learner. The cron
// selects audience users WITHOUT a row for the sequence, sends, then writes the
// row; the @@unique makes a double-send a constraint violation, not a duplicate.
// `sequence` is the email id from docs/sales/lifecycle-emails.md (e.g. "1.1",
// "2.1", "5.3").
model LifecycleSend {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sequence String
  sentAt   DateTime @default(now())

  @@unique([userId, sequence])
  @@index([userId])
}

model Revision {
  id                    String    @id @default(cuid())
  projectId             String
  project               Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label                 String // case-preserving; case-insensitive uniqueness via functional index (§4.3)
  currentStage          Stage     @default(REQUIREMENTS)
  currentStageEnteredAt DateTime  @default(now())
  bomFrozenAt           DateTime?
  frozenAt              DateTime?
  frozenById            String?
  frozenBy              User?     @relation("FrozenBy", fields: [frozenById], references: [id], onDelete: Restrict)
  schematicCommit       String?
  layoutCommit          String?
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  transitions     StageTransition[]
  artifacts       Artifact[]
  bomLines        BomLine[]
  builds          Build[]
  checklists      Checklist[]
  guide           Guide?
  errata          Erratum[]         @relation("RevisionErrata")
  addressedErrata Erratum[]         @relation("AddressedByRevision")
  enrollments     Enrollment[]      @relation("EnrollmentRevision")
  publishedFor    Project?          @relation("PublishedRevision")
  // Raw migration: CREATE UNIQUE INDEX revision_project_label_ci ON "Revision"(projectId, lower(label));

  @@index([projectId, currentStage])
}

// ─── Stage state machine ───────────────────────────────
enum Stage {
  REQUIREMENTS
  SCHEMATIC
  BOM_SOURCING
  LAYOUT
  DRC_GERBER
  ORDERING
  ASSEMBLY
  BRINGUP
  REVISION
}

enum TransitionDirection {
  INIT
  ADVANCE
  REGRESS
}

model StageTransition {
  id             String              @id @default(cuid())
  revisionId     String
  revision       Revision            @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  fromStage      Stage? // null for INIT
  toStage        Stage // may skip intermediates on createBuild regress (§5.3)
  direction      TransitionDirection
  gateSnapshot   Json // see §5.2
  notes          String? // required when direction = REGRESS
  transitionedBy String
  user           User                @relation(fields: [transitionedBy], references: [id], onDelete: Restrict)
  transitionedAt DateTime            @default(now())

  @@index([revisionId, transitionedAt])
}

// ─── Artifacts (Revision-scoped XOR Build-scoped) ──────
enum ArtifactKind {
  FILE
  NOTE
  LINK
}

enum ArtifactSubkind {
  GENERIC // owner-agnostic (either Revision or Build)
  REQUIREMENTS_DOC // Revision-scoped
  SCHEMATIC_FILE // Revision-scoped
  ERC_REPORT // Revision-scoped; SCHEMATIC gate (clean ERC — the schematic-stage analog of DRC_REPORT)
  BOM_EXPORT // Revision-scoped
  LAYOUT_FILE // Revision-scoped
  DRC_REPORT // Revision-scoped
  GERBER_ZIP // Revision-scoped
  PCB_ORDER // Build-scoped; ORDERING gate
  PARTS_ORDER // Build-scoped; ORDERING gate
  ASSEMBLY_PROCEDURE // Revision-scoped template
  BENCH_PROCEDURE // Revision-scoped template
  BRINGUP_LOG // Build-scoped; BRINGUP gate
  BRINGUP_COMPLETE // Build-scoped; BRINGUP gate; created via "Mark bring-up complete" button only
  BOM_CSV_AS_ORDERED // Build-scoped; the BOM as actually sent to the distributor
  ASSEMBLY_PHOTO // Build-scoped; photos taken during assembly / bring-up
  BRINGUP_MEASUREMENTS_CSV // Build- or revision-scoped; export of Measurement rows (WS5 attaches a verified set to the published revision)
  MODEL_3D // 3D model artifact (board/sub-assembly); renderable via <ModelViewer>
}

model Artifact {
  id         String          @id @default(cuid())
  revisionId String?
  revision   Revision?       @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  buildId    String?
  build      Build?          @relation(fields: [buildId], references: [id], onDelete: Cascade)
  // Learner proof artifacts attach to an Enrollment (enrollmentId non-null);
  // author/reference artifacts keep enrollmentId = null (revision-scoped).
  enrollmentId String?
  enrollment   Enrollment?   @relation("EnrollmentArtifacts", fields: [enrollmentId], references: [id], onDelete: Cascade)
  stage      Stage // workflow stage this artifact belongs to
  kind       ArtifactKind
  subkind    ArtifactSubkind @default(GENERIC)
  title      String
  fileKey    String?
  fileMime   String?
  fileBytes  Int? // server-enforced ≤ 100 MB; HEAD-verified
  renderKey    String?   // derived .glb for MODEL_3D artifacts (board stub)
  renderBytes  Int?
  renderMime   String?
  renderBounds Json?
  noteBody   String? // markdown
  linkUrl    String?
  createdBy  String
  user       User            @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt  DateTime        @default(now())
  // Content-validation result for validated proof subkinds (ERC_REPORT → errors==0).
  // null = not validated (presence-only subkinds, or links we can't parse).
  valid            Boolean?
  // Human-readable validator outcome surfaced in the gate + modal ("5 errors, 5 warnings").
  validationDetail String?

  @@index([revisionId, stage])
  @@index([buildId, stage])
  @@index([buildId, subkind])
  @@index([enrollmentId])
}

// Raw migration CHECKs:
//   artifact_owner_xor: exactly one of (revisionId, buildId, enrollmentId) is non-null.
//     (enrollmentId-owned = learner proof artifacts; revision/build-owned = author/reference.)
//   artifact_kind_payload_xor: exactly one of (fileKey, noteBody, linkUrl) is non-null per kind.

// ─── Builds + Boards ───────────────────────────────────
model Build {
  id                String    @id @default(cuid())
  revisionId        String
  revision          Revision  @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  label             String // case-preserving (e.g. "BUILD-001"); case-insensitive uniqueness via functional index
  boardCount        Int
  pcbOrderRef       String?
  partsOrderRef     String?
  orderedAt         DateTime?
  receivedAt        DateTime?
  assemblyStartedAt DateTime?
  frozenAt          DateTime? // set when parent revision freezes; freeze actor lives on Revision.frozenById
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdById       String
  createdBy         User      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  boards     Board[]
  checklists Checklist[]
  artifacts  Artifact[]
  // Raw migration: CREATE UNIQUE INDEX build_revision_label_ci ON "Build"(revisionId, lower(label));
  // Phase 1 invariant via raw migration:
  //   CREATE UNIQUE INDEX build_one_unfrozen_per_revision ON "Build"(revisionId) WHERE "frozenAt" IS NULL;

  // Covers (a) the §9.1 Builds-pane sort `ORDER BY frozenAt NULLS FIRST, createdAt DESC`
  // and (b) the active-Build lookup `WHERE frozenAt IS NULL` (Phase 1: 0 or 1 row).
  @@index([revisionId, frozenAt, createdAt])
}

enum BoardStatus {
  BARE
  SCREENED
  ASSEMBLED
  POWERED
  BROUGHT_UP
  FAILED // blocks gates; must be repaired (→ASSEMBLED) or QUARANTINED
  QUARANTINED // permanently removed; passes gates as "done"
}

model Board {
  id             String      @id @default(cuid())
  buildId        String
  build          Build       @relation(fields: [buildId], references: [id], onDelete: Cascade)
  serial         String // case-preserving (e.g. "B01"); case-insensitive uniqueness via functional index
  silkscreenHash String? // git hash printed on PCB; raw migration CHECK validates format if non-null
  status         BoardStatus @default(BARE)
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  checklists   Checklist[]
  measurements Measurement[]
  // Raw migration: CREATE UNIQUE INDEX board_build_serial_ci ON "Board"(buildId, lower(serial));

  @@index([buildId, status])
}

// ─── Checklists + Items ────────────────────────────────
enum ChecklistSubkind {
  GENERIC
  EQUIPMENT_PREFLIGHT
  SCREENING_STEP_0
  ASSEMBLY_STEPS
  POST_ASSEMBLY_CONTINUITY // ASSEMBLY gate matches on this subkind
  POLARITY_VERIFICATION
  REQUIREMENTS_REVIEW      // m16: gated at REQUIREMENTS exit
  LAYOUT_REVIEW            // m16: gated at LAYOUT exit
  STRIPBOARD_VALIDATION    // m17: gated at BOM_SOURCING exit when project.requiresStripboard
  DESIGN_VALIDATION        // WS1: design-validation record (no gate yet; WS4 board-readiness consumes it)
}

model Checklist {
  id          String           @id @default(cuid())
  revisionId  String?
  revision    Revision?        @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  buildId     String?
  build       Build?           @relation(fields: [buildId], references: [id], onDelete: Cascade)
  boardId     String?
  board       Board?           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  stage       Stage
  subkind     ChecklistSubkind @default(GENERIC)
  title       String // user-facing label; subkind drives gate matching
  createdAt   DateTime         @default(now())
  createdById String
  createdBy   User             @relation(fields: [createdById], references: [id], onDelete: Restrict)

  items ChecklistItem[]

  @@index([revisionId, stage])
  @@index([buildId, stage])
  @@index([boardId, stage])
  @@index([stage])
  @@index([buildId, subkind])
  @@index([revisionId, subkind])
}

// Raw migration CHECK:
//   checklist_owner_xor (3-way per m15):
//     exactly one of (revisionId, buildId, boardId) is non-null.

model ChecklistItem {
  id            String    @id @default(cuid())
  checklistId   String
  checklist     Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  ordinal       Int
  label         String
  expectedValue String?
  actualValue   String?
  checked       Boolean   @default(false)
  notApplicable Boolean   @default(false)
  completedAt   DateTime?
  completedById String?
  completedBy   User?     @relation("CompletedBy", fields: [completedById], references: [id], onDelete: Restrict)

  @@unique([checklistId, ordinal])
}

// Raw migration CHECK:
//   checklist_item_checked_xor_napplicable: NOT (checked AND notApplicable).

// ─── Measurements ──────────────────────────────────────
enum MeasurementResult {
  PASS
  FAIL
  OBSERVED // recorded reading without pass/fail adjudication (e.g., "OL", "3.7 V baseline")
  PEND // not yet measured
}

model Measurement {
  id            String            @id @default(cuid())
  boardId       String
  board         Board             @relation(fields: [boardId], references: [id], onDelete: Cascade)
  stage         Stage
  step          String
  expectedValue String?
  actualValue   String
  unit          String?
  result        MeasurementResult @default(PEND)
  notes         String?
  measuredAt    DateTime          @default(now())
  measuredById  String
  measuredBy    User              @relation(fields: [measuredById], references: [id], onDelete: Restrict)

  @@index([boardId, stage])
  @@index([boardId, step])
}

// ─── Parts library (GLOBAL) ────────────────────────────
enum PartLifecycle {
  ACTIVE
  NRND
  EOL
  OBSOLETE
}

// ─── Parts knowledge (Stage A) ─────────────────────────
enum PartCategory {
  RF_MODULE
  LDO_REGULATOR
  USB_UART_IC
  MLCC_CAPACITOR
  USB_CONNECTOR
  PASSIVE_RESISTOR
}

enum PartFactGroup {
  PARAMETRICS
  PINOUT
  POWER
  DERATING
  MECHANICAL
  NOTES
}

enum FactTrust {
  UNVERIFIED
  VERIFIED
  FLAGGED
}

enum FactSourceKind {
  DATASHEET
  MANUAL
  API
}

// Hierarchical category tree (Phase B). Parent/child + a materialized `path`
// of slugs ("passives/capacitors/MLCC_CAPACITOR") so a subtree filter is a
// single `path startsWith` scan. The 6 migrated leaves carry slug = the old
// `PartCategory` enum token (the enum→tree bridge); new interior nodes get
// kebab slugs. The `PartCategory` enum column on `Part` is RETAINED during the
// transition; reads bridge `categoryRef?.slug ?? category`.
model Category {
  id        String     @id @default(cuid())
  slug      String     @unique // migrated leaves: the old enum token; new nodes: kebab
  name      String // human label, e.g. "MLCC Capacitors"
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  path      String     @unique // materialized slugs: "passives/capacitors/MLCC_CAPACITOR"
  depth     Int        @default(0)
  order     Int        @default(0)
  defaultKicadSymbol       String? // Phase C (seeded empty here)
  defaultKicadFootprintLib String? // Phase C (seeded empty here)
  parts     Part[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([parentId])
  @@index([path])
}

model Part {
  id           String        @id @default(cuid())
  mpn          String
  manufacturer String
  description  String
  category     PartCategory?
  categoryId   String?
  categoryRef  Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  footprint    String?
  datasheetUrl String?
  // KiCad standard-library references — used by the export when a part has no
  // uploaded asset (before falling back to a stub): a symbol lib-id (e.g.
  // "Device:R") and a footprint lib-id (e.g. "Resistor_SMD:R_0805_2012Metric").
  kicadSymbol    String?
  kicadFootprint String?
  lifecycle    PartLifecycle @default(ACTIVE)
  isCertifiedModule Boolean  @default(false)
  notes        String? // ECN/sourcing swaps recorded here (free text)
  // DigiKey availability snapshot (watchdog). DigiKey's OBSERVED status is kept
  // separate from the curated `lifecycle` so a divergence is itself a signal.
  dkStockQty        Int?
  dkUnitPriceCents  Int?
  dkInStock         Boolean?
  dkLifecycle       String?   // DigiKey ProductStatus.Status (Active/Obsolete/NRND/…)
  dkProductUrl      String?
  dkPartNumber      String?   // DigiKey part number (lowest-MOQ variation) for FastAdd cart URLs
  dkCheckedAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdById  String
  createdBy    User          @relation(fields: [createdById], references: [id], onDelete: Restrict)

  bomLines           BomLine[]
  factGroups         PartFact[]
  datasheet          PartDatasheet?
  assets             PartAsset[]
  availabilityEvents PartAvailabilityEvent[]

  @@unique([manufacturer, mpn])
  @@index([mpn])
  @@index([manufacturer])
  @@index([category])
  @@index([categoryId])
  @@index([lifecycle])
}

// Append-only watchdog feed — one row only when a part's availability changes
// materially (not every nightly check). `kind` is a free string (no enum mirror).
model PartAvailabilityEvent {
  id        String   @id @default(cuid())
  partId    String
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  kind      String // WENT_OBSOLETE | WENT_OOS | BACK_IN_STOCK | LIFECYCLE_CHANGED | NO_MATCH
  fromValue String?
  toValue   String?
  createdAt DateTime @default(now())

  @@index([partId, createdAt])
  @@index([createdAt])
}

model PartDatasheet {
  id          String   @id @default(cuid())
  partId      String   @unique
  part        Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  r2Key       String // parts/{partId}/datasheet-...pdf
  filename    String
  byteSize    Int
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
}

model PartFact {
  id              String         @id @default(cuid())
  partId          String
  part            Part           @relation(fields: [partId], references: [id], onDelete: Cascade)
  group           PartFactGroup
  data            Json
  trust           FactTrust      @default(UNVERIFIED)
  // provenance (group-level fallback; element anchors live in `data`)
  sourceKind      FactSourceKind @default(DATASHEET)
  partDatasheetId String?
  sourcePage      Int?
  sourceUrl       String?
  sourceNote      String?
  // verification + audit
  verifiedById    String?
  verifiedAt      DateTime?
  lastEditedById  String?
  createdById     String
  createdBy       User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([partId, group])
  @@index([trust])
}

enum PartAssetKind {
  SYMBOL
  FOOTPRINT
  MODEL_3D
}

model PartAsset {
  id             String        @id @default(cuid())
  partId         String
  part           Part          @relation(fields: [partId], references: [id], onDelete: Cascade)
  kind           PartAssetKind
  r2Key          String        // parts/{partId}/{kind}-{cuid}.{ext}
  filename       String
  byteSize       Int
  contentType    String
  renderKey      String?   // R2 key of the derived .glb (parts/{partId}/model_3d_render-{cuid}.glb)
  renderBytes    Int?
  renderMime     String?   // "model/gltf-binary"
  renderBounds   Json?     // { center: [x,y,z], radius } — frames the viewer camera
  ref            String?       // symbol/footprint name (sym-lib-table descr data)
  source         String?       // SnapEDA | SamacSys | Ultra Librarian | manufacturer | hand-made
  license        String?
  trust          FactTrust     @default(UNVERIFIED)
  verifiedById   String?
  verifiedAt     DateTime?
  lastEditedById String?
  createdById    String
  createdBy      User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([partId, kind])
  @@index([trust])
}

// ─── KiCad standard-library index + def cache (Phase C) ────────────────
// Searchable mirror of the KiCad 10 standard libraries (ingested from the local
// install), powering the create-form symbol/footprint pickers. pg_trgm GIN
// search indexes on a name‖keywords‖description (resp. name‖description‖tags)
// expression are added in the raw migration (not expressible in Prisma schema).
model KicadLibSymbol {
  libId       String  @id // "Device:R"
  lib         String
  name        String
  keywords    String?
  description String?
  datasheet   String? // seeds Part.datasheetUrl on pick when present
  fpFilters   String? // ki_fp_filters → (future) footprint-picker narrowing

  @@index([lib])
}

model KicadLibFootprint {
  libId       String  @id // "Resistor_SMD:R_0805_2012Metric"
  lib         String
  name        String
  description String?
  tags        String?
  padCount    Int?

  @@index([lib])
}

// Flattened (extends-resolved), self-contained "(symbol ...)" text the export
// embeds. Populated lazily by the layered resolver on first reference.
model KicadSymbolDefCache {
  libId   String   @id
  text    String
  version String // KiCad release tag; cache-bust on bump
  builtAt DateTime @default(now())
}

model BomLine {
  id          String   @id @default(cuid())
  revisionId  String
  revision    Revision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  partId      String
  part        Part     @relation(fields: [partId], references: [id], onDelete: Restrict)
  refDes      String // raw migration CHECK: array_length(string_to_array(refDes, ','), 1) = quantity
  quantity    Int
  notes       String?
  // WS1: second-source / alternate part. Informational sourcing hint — NOT a
  // FK to Part; either field may be present alone. Price is deliberately out
  // of scope here (cost roll-up is WS3; never reuse the name priceCents).
  altMpn          String?
  altManufacturer String?
  unitPriceCents  Int?    // WS3: quoted unit price (cents) for design-to-cost. NOT priceCents (that's Project's course price).
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([revisionId, partId])
  @@index([partId])
}

// ─── Errata ────────────────────────────────────────────
enum ErratumSeverity {
  BLOCKER
  MAJOR
  MINOR
}

enum ErratumStatus {
  OPEN
  FIXED_NEXT_REV
  WONT_FIX
}

model Erratum {
  id                    String          @id @default(cuid())
  revisionId            String
  revision              Revision        @relation("RevisionErrata", fields: [revisionId], references: [id], onDelete: Cascade)
  title                 String
  description           String
  severity              ErratumSeverity
  status                ErratumStatus   @default(OPEN)
  addressedByRevisionId String?
  addressedBy           Revision?       @relation("AddressedByRevision", fields: [addressedByRevisionId], references: [id], onDelete: Restrict)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  createdById           String
  createdBy             User            @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([revisionId, status])
  @@index([addressedByRevisionId])
}

enum CurriculumTrack {
  SENSE
  ACT
  POWER
  COMMS
}

enum CurriculumLevel {
  L1
  L2
  L3
}

// Per-project access tier (GTM roadmap). PUBLIC = no-account readable (the SEO
// surface / per-track flagships); FREE = needs a free account; PREMIUM = paid.
enum AccessTier {
  PUBLIC
  FREE
  PREMIUM
}

// How an Entitlement was acquired. GRANT = admin comp/test; PURCHASE = one-time
// Stripe payment (course or Pass); SUBSCRIPTION = an active recurring subscription
// (minted/revoked by the subscription webhook on status transitions).
enum EntitlementSource {
  GRANT
  PURCHASE
  SUBSCRIPTION
}

// How a Library mini-lesson links to a Quest/Catalog Project.
//   SUPPORTING  = the article supports / explains this project (renders an up-link).
//   DOWN_FUNNEL = the article's end-of-page CTA into this gated build.
enum MiniLessonLinkRole {
  SUPPORTING
  DOWN_FUNNEL
}

enum ProjectDepKind {
  DE_RISK
  FOUNDATION
  SHARED_BLOCK
}

model ProjectDependency {
  id                     String         @id @default(cuid())
  dependentProjectId     String
  dependentProject       Project        @relation("DependentProject",  fields: [dependentProjectId], references: [id], onDelete: Cascade)
  dependsOnProjectId     String
  dependsOnProject       Project        @relation("DependsOnProject",  fields: [dependsOnProjectId], references: [id], onDelete: Restrict)
  kind                   ProjectDepKind @default(DE_RISK)
  dependentStageGated    Stage
  dependsOnStageRequired Stage
  notes                  String?
  createdAt              DateTime       @default(now())
  createdById            String
  createdBy              User           @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([dependentProjectId, dependsOnProjectId, dependentStageGated])
  @@index([dependentProjectId])
  @@index([dependsOnProjectId])
}

model Guide {
  id            String           @id @default(cuid())
  revisionId    String           @unique
  revision      Revision         @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  title         String
  trackSnapshot CurriculumTrack?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  createdById   String
  createdBy     User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  cards         GuideCard[]
}

model GuideCard {
  id            String   @id @default(cuid())
  guideId       String
  guide         Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  stage         Stage
  ordinal       Int
  eyebrow       String
  title         String
  lead          String?
  contentBlocks Json
  isGate        Boolean  @default(false)
  completionRef Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([guideId, ordinal])
  @@unique([guideId, stage])
  @@index([guideId])
}

// A public, gate-less Library mini-lesson (content-model §2.1/§3). Reuses the
// guide content-block schema (`contentBlocks` Json, validated by
// guideContentBlocksSchema + the Library allowlist) and the GuideBlocks renderer
// — it just has no stages / gates / builds / enrollment. accessTier defaults
// PUBLIC (a gated SEO page earns nothing); the URL is gated by middleware, not
// the Entitlement paywall.
model MiniLesson {
  id             String              @id @default(cuid())
  slug           String              @unique
  title          String
  summary        String?
  contentBlocks  Json
  published      Boolean             @default(false)
  accessTier     AccessTier          @default(PUBLIC)
  seoTitle       String?
  seoDescription String?
  byline         String? // "last verified vs vX.Y on <date>" + author — first-hand-value signal
  lastVerifiedAt DateTime?
  cluster        String? // Library cluster / Field Guide key (LIBRARY_CLUSTERS); null = unclustered "other" bucket
  clusterOrdinal Int                 @default(0) // order WITHIN the cluster — single source of truth for within-cluster order
  // ── DERIVED from contentBlocks. Never hand-set these: the client extension in
  // src/lib/db.ts recomputes them on every create/update/upsert that carries
  // contentBlocks. Derived so /library can render every lesson without SELECTing
  // (heavy) contentBlocks just to get three scalars. Source of truth for the
  // derivation is src/lib/library/derived.ts; a vitest drift guard proves they
  // still match. See docs/plans/2026-07-15-library-derived-columns.md.
  readingMinutes Int                 @default(1)
  questionCount  Int                 @default(0)
  diagramSrc     String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  createdById    String
  createdBy      User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  relatedProjects ProjectMiniLesson[]

  @@index([published])
}

// The MiniLesson ↔ Project (Quest node) link — the internal-linking spine.
model ProjectMiniLesson {
  id           String             @id @default(cuid())
  projectId    String
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  miniLessonId String
  miniLesson   MiniLesson         @relation(fields: [miniLessonId], references: [id], onDelete: Cascade)
  role         MiniLessonLinkRole @default(SUPPORTING)
  ordinal      Int                @default(0)
  createdAt    DateTime           @default(now())

  @@unique([projectId, miniLessonId, role])
  @@index([miniLessonId])
  @@index([projectId])
}

// A learner's recorded pass of a stage card's comprehension quiz. Soft-gating:
// the quiz is client-scored and this row is written when the learner passes, so
// the stage exit gate can require it (ANDed with the work-gate). Scoped to the
// Revision — the same per-revision scope every other gate uses — so one row per
// (revision, stage). `score`/`total` are kept for record-keeping only.
model QuizPass {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stage        Stage
  score        Int
  total        Int
  passedAt     DateTime   @default(now())

  @@unique([enrollmentId, stage])
  @@index([enrollmentId])
}

// ─── Per-user progress ─────────────────────────────────
enum EnrollmentStatus {
  IN_PROGRESS
  COMPLETED
  MASTERED
}

// A learner's own track through a board. Carries the learner's `currentStage`
// (the shared Revision.currentStage is "where the AUTHOR is on the reference
// build"). Gated by per-enrollment quizzes + proof artifacts (see learner-gates).
model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisionId String // snapshot of project.publishedRevisionId at enroll time
  revision   Revision @relation("EnrollmentRevision", fields: [revisionId], references: [id], onDelete: Restrict)

  currentStage          Stage            @default(REQUIREMENTS)
  currentStageEnteredAt DateTime         @default(now())
  status                EnrollmentStatus @default(IN_PROGRESS)
  startedAt             DateTime         @default(now())
  completedAt           DateTime?
  masteredAt            DateTime?

  quizPasses  QuizPass[]
  artifacts   Artifact[]   @relation("EnrollmentArtifacts")
  examResults ExamResult[]

  // Cross-device resume position, keyed by stage:
  // { [stage]: { anchorId, visited: string[], ts } }. Written by the guide's
  // IslandRail via saveResume(); merged with the learner's localStorage.
  resumeState Json?

  @@unique([userId, projectId])
  @@index([userId])
}

// ─── Optional board exam (server-scored → MASTERED) ────
model Exam {
  id            String   @id @default(cuid())
  projectId     String   @unique
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  passThreshold Int // percent 0-100 the learner must reach
  questions     Json // [{id,prompt,options[],correctIndex}] — answer key server-only
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  results ExamResult[]
}

model ExamResult {
  id           String     @id @default(cuid())
  examId       String
  exam         Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  score        Int
  total        Int
  passed       Boolean
  answers      Json? // the learner's submitted answers, for review
  submittedAt  DateTime   @default(now())

  @@index([enrollmentId])
}

// ─── Logbook (XP progression) ──────────────────────────
// Append-only XP ledger (the Logbook's source of truth). Total XP = sum(amount);
// User.xpTotal/level are cached mirrors updated in the same transaction as each
// insert. dedupeKey is the idempotency guard: daily sources embed the academy-day
// date, once-ever sources don't. NEVER update or delete rows outside the admin
// reset (design §6).
model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  source    XpSource
  amount    Int
  refId     String? // lesson slug / questionKey / clusterKey / feedbackId
  earnedOn  DateTime @db.Date
  dedupeKey String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([source, refId])
}

// Durable once-ever lesson completion (drives progress + cluster/library patches).
// Distinct from the daily LESSON_COMPLETE practice XP (design §5).
model LessonCompletion {
  userId      String
  lessonSlug  String
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, lessonSlug])
}

// A wrong first pick on a question locks its XP until the next academy day
// (anti guess-farming, design §5).
model QuizLock {
  userId      String
  questionKey String // stable question id (see Task 2)
  lockedOn    DateTime @db.Date
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, questionKey, lockedOn])
}

// ─── Cross-session review deck (step 4, 2026-07-21) ─────────────────────────
// See docs/plans/2026-07-21-review-deck-design.md.

// Registry of REVIEW-able quiz items. Populated forward-only from the stage-quiz
// answer path (a snapshot of the question at answer time), so the /review deck can
// render an item by its stable reviewItemId without re-parsing contentBlocks JSON.
// reviewItemId = <projectSlug>:<stage>:<reviewId>, revision-independent (survives a
// revision bump) and decoupled from questionKey (so marking a question reviewable
// never re-keys the XP ledger). Refreshed on each encounter (last-writer-wins), so
// a content edit propagates on the next stage answer.
model QuizItem {
  reviewItemId String           @id
  projectSlug  String
  // Guide stage, or NULL for a library (mini-lesson) item, which has no stage.
  stage        Stage?
  q            String
  options      String[]
  answer       Int
  updatedAt    DateTime         @updatedAt
  schedules    ReviewSchedule[]

  @@index([projectSlug])
}

// A learner's spaced-review schedule for one item. Created forward-only at the
// item's first encounter (start-fresh: no history bootstrap). `dueOn`/`intervalDays`
// drive the ladder (see review-schedule.ts); `suspended` retires a leech.
model ReviewSchedule {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewItemId String
  item         QuizItem @relation(fields: [reviewItemId], references: [reviewItemId], onDelete: Cascade)
  dueOn        DateTime @db.Date
  intervalDays Int      @default(1)
  lapses       Int      @default(0)
  suspended    Boolean  @default(false)
  lastSeenOn   DateTime @db.Date
  createdAt    DateTime @default(now())

  @@unique([userId, reviewItemId])
  @@index([userId, dueOn])
}

// Admin write audit (2026-07-13): every MANUAL logbook mutation from the per-learner
// admin tooling — grant/revoke a patch, adjust XP, override level — records who did
// what to whom, for accountability. Plain string ids (no FK) so the trail survives a
// learner deletion.
model AdminAudit {
  id           String   @id @default(cuid())
  actorId      String // the admin who performed the action
  action       String // "grant_patch" | "revoke_patch" | "adjust_xp" | "set_level"
  targetUserId String // the learner affected
  detail       Json? // { badgeKey } | { amount, note } | { level, prevLevel } ...
  createdAt    DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([actorId, createdAt])
}

// Patches / ratings / wings. Earned = permanent (grandfathered, design §7);
// meta records the milestone size (e.g. { asOfLessonCount: 69 }).
model BadgeEarned {
  userId   String
  badgeKey String
  earnedAt DateTime @default(now())
  meta     Json?
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, badgeKey])
}

// Per-page lesson feedback (the no-forum channel, design §9.4). Routes to admin;
// USEFUL pays the bonus + the Shipped It patch.
model LessonFeedback {
  id        String         @id @default(cuid())
  userId    String
  pageRef   String // e.g. "library/ohms-law"
  body      String
  status    FeedbackStatus @default(NEW)
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId, pageRef])
}

