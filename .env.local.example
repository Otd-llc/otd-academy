# Copy to .env.local and fill in real values.

# Neon Postgres. Two URLs: pooled (DATABASE_URL, runtime) + direct (DIRECT_URL, migrations).
DATABASE_URL="postgresql://USER:PASS@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASS@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Test database(s) — ISOLATED Neon branches (NOT prod). Go in .env.test.local
# (gitignored) locally; CI sets them directly. When present, vitest points
# DATABASE_URL/DIRECT_URL at them so `pnpm test` never mutates prod (vitest.env.ts).
# TEST_DATABASE_POOL is a comma-separated list of branch URLs — each parallel DB
# test file leases its own branch, so the suite parallelizes without SSI conflicts.
# A single TEST_DATABASE_URL also works (runs the DB tests effectively serial).
# TEST_DATABASE_URL="postgresql://USER:PASS@BRANCH1-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# TEST_DATABASE_POOL="postgresql://...BRANCH1...,postgresql://...BRANCH2...,postgresql://...BRANCH3..."

# Auth.js. AUTH_SECRET via: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="generate-32-bytes-base64"
AUTH_GOOGLE_ID="from-google-cloud-console.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-from-google-cloud-console"

# Allowlist. Comma-separated, no spaces.
ALLOWED_EMAILS="you@example.com,partner@example.com"

# Cloudflare R2. Optional until M8b file-artifact support lands.
R2_ENABLED="false"
# R2_ACCOUNT_ID=""
# R2_BUCKET=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""

# PostHog funnel instrumentation. OPTIONAL: leave NEXT_PUBLIC_POSTHOG_KEY unset
# and ALL analytics (browser pageviews + server funnel events) are a no-op — so
# local/CI/test builds run with analytics disabled and never make a network call.
# Set the public project key to turn it on. HOST defaults to https://us.i.posthog.com.
# NEXT_PUBLIC_POSTHOG_KEY="phc_your_project_key"
# NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Parts-knowledge MCP server (Stage B). The read-only Neon role `foundry_ro`
# (GRANT SELECT + default_transaction_read_only=on). MUST differ from DATABASE_URL.
# Build from the pooled DATABASE_URL by swapping the userinfo to foundry_ro:<pw>.
# PARTS_MCP_DATABASE_URL="postgresql://foundry_ro:PASS@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
