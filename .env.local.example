# Copy to .env.local and fill in real values.

# ── DEV DATABASE: LOCAL Postgres 17 ──
# `next dev`, `pnpm db:seed`, and every scripts/*.ts hit THIS — safe by default.
# Setup: winget install PostgreSQL.PostgreSQL.17, then CREATE DATABASE foundry_dev.
# Hydrate it from prod with: pnpm db:pull-prod
# Local needs no pooler, so DATABASE_URL == DIRECT_URL.
# The adapter is chosen by URL (src/lib/db-adapter.ts): a localhost URL uses
# node-postgres, a *.neon.tech URL uses the Neon serverless driver.
DATABASE_URL="postgresql://postgres:PASS@localhost:5432/foundry_dev"
DIRECT_URL="postgresql://postgres:PASS@localhost:5432/foundry_dev"

# ── PROD Neon. NOT the default target. ──
# Pooled (PROD_DATABASE_URL, runtime) + direct (PROD_DIRECT_URL, migrations/pg_dump —
# pg_dump cannot run through the pooler). Reached ONLY via:
#   pnpm db:prod <script>   (prompts for confirmation)
#   pnpm db:migrate:prod
#   pnpm db:pull-prod       (reads prod, writes local)
# Why: pointing dev at these burned 4.73 GB of the 5 GB account egress and 70% of
# the 100 CU-h/project compute by mid-July 2026.
# See docs/plans/2026-07-15-dev-off-prod-local-postgres.md.
PROD_DATABASE_URL="postgresql://USER:PASS@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
PROD_DIRECT_URL="postgresql://USER:PASS@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Test database(s) — ISOLATED Neon branches (NOT prod). Go in .env.test.local
# (gitignored) locally; CI sets them directly. When present, vitest points
# DATABASE_URL/DIRECT_URL at them so `pnpm test` never mutates prod (vitest.env.ts).
# TEST_DATABASE_POOL is a comma-separated list of branch URLs — each parallel DB
# test file leases its own branch, so the suite parallelizes without SSI conflicts.
# A single TEST_DATABASE_URL also works (runs the DB tests effectively serial).
# TEST_DATABASE_URL="postgresql://USER:PASS@BRANCH1-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# TEST_DATABASE_POOL="postgresql://...BRANCH1...,postgresql://...BRANCH2...,postgresql://...BRANCH3..."

# Auth.js. AUTH_SECRET via: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# EVERY var in this block is REQUIRED by src/env.ts — the schema has no .optional()
# or .default() on any of them, so a missing one fails the build, not just sign-in.
AUTH_SECRET="generate-32-bytes-base64"
AUTH_GOOGLE_ID="from-google-cloud-console.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-from-google-cloud-console"
# GitHub OAuth app: Settings > Developer settings > OAuth Apps. Callback URL is
# http://localhost:3000/api/auth/callback/github for local dev.
AUTH_GITHUB_ID="Iv1.from-github-oauth-app"
AUTH_GITHUB_SECRET="from-github-oauth-app"
# Resend — the magic-link ("email") provider. AUTH_RESEND_FROM must be on a domain
# verified in Resend, or sends 403 and sign-in fails with ?error=Configuration.
AUTH_RESEND_KEY="re_your_resend_api_key"
AUTH_RESEND_FROM="OTD Academy <hello@your-verified-domain.com>"

# Physical postal address stamped into lifecycle email footers. REQUIRED: CAN-SPAM
# obliges a real mailing address on commercial email, so the schema will not default it.
LIFECYCLE_POSTAL_ADDRESS="Your Company, 123 Example St, City, ST 00000, USA"

# Allowlist. Comma-separated, no spaces.
ALLOWED_EMAILS="you@example.com,partner@example.com"

# Cloudflare R2. Optional until M8b file-artifact support lands.
R2_ENABLED="false"
# R2_ACCOUNT_ID=""
# R2_BUCKET=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""

# PostHog funnel instrumentation. OPTIONAL: leave NEXT_PUBLIC_POSTHOG_KEY unset
# and ALL analytics (browser pageviews + server funnel events) are a no-op — so
# local/CI/test builds run with analytics disabled and never make a network call.
# Set the public project key to turn it on. HOST defaults to https://us.i.posthog.com.
# NEXT_PUBLIC_POSTHOG_KEY="phc_your_project_key"
# NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Parts-knowledge MCP server (Stage B). The read-only role `foundry_ro`
# (GRANT SELECT). MUST differ from DATABASE_URL — mcp/parts-server/env.ts asserts
# it. Points at the LOCAL dev DB; create the role with:
#   CREATE ROLE foundry_ro LOGIN PASSWORD '<pw>';
#   GRANT CONNECT ON DATABASE foundry_dev TO foundry_ro;
#   GRANT USAGE ON SCHEMA public TO foundry_ro;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO foundry_ro;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT ON TABLES TO foundry_ro;
# PARTS_MCP_DATABASE_URL="postgresql://foundry_ro:PASS@localhost:5432/foundry_dev"

# ── Signup abuse defense (docs/plans/2026-07-16-signup-abuse-defense-design.md) ──
# ALL OPTIONAL. Unset locally = the defense no-ops (Turnstile passes, limiter off) —
# the intended dev behavior; the controls live on Vercel Preview/Prod. UNSET IN
# PRODUCTION = an UNPROTECTED deploy (a startup warn fires). Each pair below is
# both-set-or-both-unset — a half-set pair FAILS the build.
#
# Cloudflare Turnstile (Layer 0). Site key is public; secret is server-side.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x..."
# TURNSTILE_SECRET_KEY="0x..."
# Upstash Redis rate limiter (Vercel Marketplace `otd-academy-ratelimit`). WRITE token
# (READ_ONLY cannot INCR).
# KV_REST_API_URL="https://....upstash.io"
# KV_REST_API_TOKEN="..."
# The magic:global:day HARD cap override (design §7.3); the policy default applies unset.
# MAGIC_GLOBAL_DAILY_CAP="2000"
# Vercel Edge Config store — the runtime kill switch (defenseEnabled, turnstileInteractive).
# Vercel injects EDGE_CONFIG when a store is connected; absent → defense reads default-on.
# EDGE_CONFIG="https://edge-config.vercel.com/ecfg_...?token=..."
